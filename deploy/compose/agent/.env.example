# Buzz Agent (Hermes native gateway) — environment (copy to .env, fill in values)
# Docs: https://hermes-agent.nousresearch.com/docs/user-guide/messaging/buzz

# ── Identity ─────────────────────────────────────────────────────────────────
# The agent's OWN keypair — never the relay owner's key.
# Mint one:  buzz-admin generate-key
# Then register the pubkey as a relay member:
#   buzz-admin add-member --pubkey <agent-pubkey-hex>
BUZZ_PRIVATE_KEY=nsec1...

# Base URL of the community relay (the adapter subscribes over WS and shells
# out to the buzz CLI; wss:// and https:// are both accepted).
BUZZ_RELAY_URL=wss://buzz.pickz-ai.com

# ── Buzz adapter (Option B — env vars) ───────────────────────────────────────
# Channel UUIDs to watch (comma-separated). Empty = all joined channels.
# BUZZ_CHANNELS=
# Channel for cron/notification delivery (defaults to the first watched).
# BUZZ_HOME_CHANNEL=
# Access control: empty + allow_all_users=false = private (only listed users).
#   BUZZ_ALLOWED_USERS=<owner-hex>,<colleague-hex>   # npubs or hex
#   BUZZ_ALLOW_ALL_USERS=true                        # community mode: any member
# Inbound poll interval seconds (default 4). Inbound normally streams via WS.
# BUZZ_POLL_INTERVAL=4
# Path to the buzz binary (default: buzz on PATH).
# BUZZ_CLI_PATH=

# ── Hermes LLM (OpenRouter) ──────────────────────────────────────────────────
# Applied at container start by entrypoint.sh — NOT baked into the image.
# Model id is bare-style (no openrouter/ prefix).
OPENROUTER_API_KEY=sk-or-v1-...
HERMES_MODEL=deepseek/deepseek-v4-flash-0731
# Auxiliary tasks (vision/title/compression) use the OpenRouter fallback model
# (paid lane — user has credits).

# ── Git / GitHub (optional, for repo work) ───────────────────────────────────
# Applied at container start by entrypoint.sh — NOT baked into the image.
GIT_USER_NAME=buzz-agent
GIT_USER_EMAIL=agent@pickz-ai.com
GITHUB_TOKEN=github_pat_...

# ── Recommended defaults (config.yaml-only, suppress tool chatter) ───────────
# display.platforms.buzz.interim_assistant_messages: false
# display.platforms.buzz.tool_progress: off
# gateway.platforms.buzz.extra.require_mention: true   # only respond when @mentioned
