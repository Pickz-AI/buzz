# Buzz Agent — environment (copy to .env, replace every value)

# ── Identity ─────────────────────────────────────────────────────────────────
# The agent's OWN keypair — never the relay owner's key.
# Mint one:  buzz-admin generate-key
# Then register the pubkey as a relay member:
#   buzz-admin add-member --pubkey <agent-pubkey-hex>
BUZZ_PRIVATE_KEY=nsec1...

# The relay this agent joins. Public WS URL is fine (one hop through the proxy).
BUZZ_RELAY_URL=wss://buzz.pickz-ai.com

# ── Runtime ───────────────────────────────────────────────────────────────────
# ACP agent under the harness. buzz-agent is bundled in this image (Tier-1).
BUZZ_ACP_AGENT_COMMAND=buzz-agent
# Sidecar MCP server with shell + file tools (also bundled in the image).
BUZZ_ACP_MCP_COMMAND=buzz-dev-mcp

# Saves RAM: spawn the LLM subprocess only when work arrives.
BUZZ_ACP_LAZY_POOL=true

# ── Shared access (two people on the same agent) ─────────────────────────────
# Default is owner-only — a team-shared agent MUST set this.
#   allowlist → owner + explicit pubkeys (recommended)
#   anyone    → every relay member
BUZZ_ACP_RESPOND_TO=allowlist
BUZZ_ACP_RESPOND_TO_ALLOWLIST=<owner-hex>,<colleague-hex>
# Owner of this agent (your pubkey). Resolves the owner-only/allowlist gate.
BUZZ_ACP_AGENT_OWNER=<owner-hex>

# ── LLM provider (for buzz-agent) ─────────────────────────────────────────────
# One of: anthropic | openai | openrouter | databricks
BUZZ_AGENT_PROVIDER=openai
OPENAI_COMPAT_API_KEY=sk-...
OPENAI_COMPAT_MODEL=gpt-5
# OPENAI_COMPAT_BASE_URL defaults to https://api.openai.com/v1
# ANTHROPIC_API_KEY / ANTHROPIC_MODEL — for BUZZ_AGENT_PROVIDER=anthropic
# OPENROUTER_API_KEY / OPENROUTER_MODEL — for BUZZ_AGENT_PROVIDER=openrouter

# ── Optional tuning ───────────────────────────────────────────────────────────
# BUZZ_ACP_SYSTEM_PROMPT=You are the team assistant...
# BUZZ_ACP_HEARTBEAT_INTERVAL=60
# BUZZ_ACP_AGENTS=2
